{
  "name": "eggd_calc_downsample_fraction",
  "title": "eggd_calc_downsample_fraction",
  "summary": "description",
  "dxapi": "1.0.0",
  "version": "1.0.0",
  "properties": {
    "githubRelease": "1.0.0"
    },
  "inputSpec": [
    {
      "name": "flagstat",
      "class": "file",
      "optional": false,
      "label": "Flagstat",
      "patterns": [
        "*.tsv", "*.json"
      ],
      "help": "samtools flagstat statistics file"
    },
    {
      "name": "target_read_count",
      "class": "int",
      "optional":false,
      "label": "Target Read Count",
      "help": "Target read count"
    }
  ],
  "outputSpec": [
    {
      "name": "target_fraction_float",
      "class": "float",
      "label": "Target fraction (float)",
      "help": "Fraction required to downsample the BAM to the desired read count"
    },
    {
      "name": "target_fraction_file",
      "class": "file",
      "label": "Target fraction (file)",
      "help": "File containing fraction specified in target_fraction_float"
    }
  ],
  "runSpec": {
    "timeoutPolicy": {
      "*": {
        "hours": 2
      }
    },
    "distribution": "Ubuntu",
    "release": "20.04",
    "version": "0",
    "interpreter": "bash",
    "file": "src/code.sh"
  },
  "developers":[
    "org-emee_1",
    "user-spaul4"
  ],
  "authorizedUsers": [
    "org-emee_1"
  ],
  "regionalOptions": {
    "aws:eu-central-1": {
      "systemRequirements": {
        "*": {
          "instanceType": "mem1_ssd1_v2_x2"
        }
      }
    }
  }
}
